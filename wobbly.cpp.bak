// ============================================================================
//  WindowsFX Lite — 全局复刻 Echooff3/wobbly-windows 的丝滑拖动
//
//  浏览器原作是 CSS：弹簧跟手 + 速度倾斜(skew) + 速度拉伸(scale)，
//  不是 Compiz 网格果冻。本工具用同一套离散弹簧，把仿射变换画在幽灵窗口上，
//  对系统里几乎所有普通顶层窗口全局生效。
//
//  编译: build.bat   （Zig c++ 静态链接）
// ============================================================================
#define WIN32_LEAN_AND_MEAN
#ifndef _WIN32_WINNT
#define _WIN32_WINNT 0x0A00
#endif
#include <windows.h>
#include <shellapi.h>
#include <mmsystem.h>
#include <algorithm>
#include <atomic>
#include <chrono>
#include <cmath>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <thread>
#include <vector>

#pragma comment(lib, "user32.lib")
#pragma comment(lib, "gdi32.lib")
#pragma comment(lib, "shell32.lib")
#pragma comment(lib, "winmm.lib")

using namespace std::chrono;

// Echooff3/wobbly-windows script.js 默认值（按 ~60fps 一帧一步）
struct Config {
    bool   enabled       = true;
    bool   snap          = true;
    int    snapDist      = 24;
    int    dragThreshold = 4;
    int    fps           = 60;
    double springK       = 0.12;   // SPRING_STIFFNESS
    double springDamp    = 0.60;   // SPRING_DAMPING
    double wobbleFactor  = 0.08;   // WOBBLE_FACTOR
    double maxSkewDeg    = 20.0;   // maxSkew
    double stretchVel    = 0.005;  // abs(v)*0.005
    double squashVel     = 0.002;  // 正交轴收缩
    double maxStretch    = 0.18;   // 防止飞甩时过度拉长
    double settleVel     = 0.12;   // px / frame
    double settleDist    = 0.6;    // px
    double maxDragSec    = 2.4;
    bool   debug         = false;
};
static Config g_cfg;

static void Dbg(const char* fmt, ...)
{
    if (!g_cfg.debug) return;
    char buf[512];
    va_list ap; va_start(ap, fmt);
    vsnprintf(buf, sizeof buf, fmt, ap);
    va_end(ap);
    wchar_t path[MAX_PATH];
    GetModuleFileNameW(nullptr, path, MAX_PATH);
    wchar_t* s = wcsrchr(path, L'\\');
    if (s) *(s + 1) = 0; else path[0] = 0;
    wcscat(path, L"wobbly_debug.log");
    HANDLE f = CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ, nullptr,
                           OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (f != INVALID_HANDLE_VALUE) {
        char out[600];
        int n = snprintf(out, sizeof out, "[%llu] %s\n",
                         (unsigned long long)GetTickCount64(), buf);
        DWORD w;
        WriteFile(f, out, n > 0 ? (DWORD)n : 0, &w, nullptr);
        CloseHandle(f);
    }
}

enum Phase { PH_IDLE = 0, PH_DRAG = 1, PH_RELEASE = 2 };
static std::atomic<int> g_phase{ PH_IDLE };
static std::atomic<int> g_cancel{ 0 };
static std::atomic<int> g_mouseX{ 0 }, g_mouseY{ 0 };
static std::atomic<bool> g_lbuttonDown{ false };
static std::atomic<bool> g_running{ true };
static std::atomic<int>  g_forceFinish{ 0 };  // 请求渲染线程收尾落地
static std::atomic<int>  g_edgeHandover{ 0 }; // 边缘松手：交还系统原生贴靠
static std::atomic<int>  g_relPtX{ 0 }, g_relPtY{ 0 }; // 松手时的光标位置（钩子记录）
static std::atomic<int>  g_absorb{ 0 };       // 注入序列期间吸收物理鼠标输入
static unsigned long long g_absorbAt = 0;     // 吸收开始时刻（2s 保底超时）
static std::atomic<bool> g_nativeDrag{ false }; // 已交还系统原生拖拽（物理松开前不接管）
static unsigned long long g_awaySince = 0;     // 光标离开边缘带超过阈值的起始时刻（重接管迟滞）
static unsigned long long g_handoverAt = 0;   // 最近一次注入合成输入的时刻
static unsigned long long g_lastAsyncHide = 0; // 最近一次异步离屏移动的时刻（验证放置用）
static HWND  g_snapHwnd = nullptr;            // 本工具贴靠过的窗口
static RECT  g_snapPrevRect{};                // 贴靠前的窗口矩形
static HWND  g_mainWnd = nullptr;             // 主窗口（提前声明，交还验证要用）
static HANDLE g_wakeEvent = nullptr;          // 拖拽开始立即唤醒渲染线程

static const wchar_t GHOST_CLASS[] = L"WindowsFXLiteGhost";
static const wchar_t MAIN_CLASS[]  = L"WindowsFXLiteMain";
static const UINT    WM_TRAY       = WM_APP + 1;
static const UINT    WM_RETARGET   = WM_APP + 2;   // 请求主线程重新接管拖拽

struct DragCtx {
    HWND hwnd = nullptr;
    int  w = 0, h = 0;
    int  grabDX = 0, grabDY = 0;
    int  origX = 0, origY = 0;
    HWND insertAfter = HWND_TOP;
    HBITMAP snapDib = nullptr; HDC snapDC = nullptr; HGDIOBJ oldSnap = nullptr;
    HWND ghost = nullptr;
    HDC outDC = nullptr; HBITMAP outDib = nullptr; HGDIOBJ oldOut = nullptr;
    void* outBits = nullptr;
    int allocW = 0, allocH = 0;
    int bw = 0, bh = 0;
    int snapW = 0, snapH = 0;   // 快照尺寸（完整窗口矩形，含透明边）
    void* snapBits = nullptr;   // 快照像素（光栅器直接读取）
    double x = 0, y = 0;     // 视觉左上角（对应 JS this.x/this.y）
    double vx = 0, vy = 0;   // 每帧像素（与 JS 一致）
    double tx = 0, ty = 0;
    double relX = 0, relY = 0;
    double skewX = 0, skewY = 0;
    double stretchX = 1, stretchY = 1;
    steady_clock::time_point releaseAt;
    // DWM 透明调整边：可见区相对整个窗口矩形的偏移。GetWindowRect 含
    // Win10/11 左右下侧的透明边，幽灵窗口若按整个矩形绘制会比真实窗口
    // 大一圈，松手还原时看起来"缩小"了，故按可见区绘制。
    int  visOffX = 0, visOffY = 0;
    bool snapOpaque = false;   // 快照 alpha 已被强制为 255
    // 从最大化窗口拉下时的"先变小"起始缩放（1 = 无此过渡）
    double introScaleX = 1, introScaleY = 1;
    double intro0X = 1, intro0Y = 1;
    bool introActive = false;
    steady_clock::time_point introStart;
    // 静止帧跳过：上一帧的位置与形状参数
    double lastQuad[8] = {0};
    double lastSkewX = 0, lastSkewY = 0;
    double lastStretchX = 1, lastStretchY = 1;
    double lastIntroX = 1, lastIntroY = 1;
    bool haveLast = false;
};
static DragCtx g_drag;

static void LoadConfig()
{
    wchar_t buf[MAX_PATH];
    GetModuleFileNameW(nullptr, buf, MAX_PATH);
    wchar_t* s = wcsrchr(buf, L'\\');
    if (s) *(s + 1) = 0; else buf[0] = 0;
    wcscat(buf, L"wobbly.ini");
    HANDLE f = CreateFileW(buf, GENERIC_READ, FILE_SHARE_READ, nullptr,
                           OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (f == INVALID_HANDLE_VALUE) return;
    LARGE_INTEGER sz{}; GetFileSizeEx(f, &sz);
    if (sz.QuadPart > 0 && sz.QuadPart < 65536) {
        std::vector<char> data((size_t)sz.QuadPart);
        DWORD rd = 0;
        if (ReadFile(f, data.data(), (DWORD)data.size(), &rd, nullptr)) {
            std::string text(data.data(), rd);
            auto trim = [](std::string t) {
                while (!t.empty() && isspace((unsigned char)t.back())) t.pop_back();
                size_t b = 0; while (b < t.size() && isspace((unsigned char)t[b])) ++b;
                return t.substr(b);
            };
            size_t pos = 0;
            while (pos < text.size()) {
                size_t nl = text.find('\n', pos);
                if (nl == std::string::npos) nl = text.size();
                std::string line = text.substr(pos, nl - pos);
                pos = nl + 1;
                if (!line.empty() && line.back() == '\r') line.pop_back();
                size_t hc = line.find('#');
                if (hc != std::string::npos) line = line.substr(0, hc);
                size_t eq = line.find('=');
                if (eq == std::string::npos) continue;
                std::string k = trim(line.substr(0, eq));
                std::string v = trim(line.substr(eq + 1));
                auto setd = [&](double& dst){ dst = atof(v.c_str()); };
                auto seti = [&](int& dst){ dst = atoi(v.c_str()); };
                auto setb = [&](bool& dst){ dst = (v == "1" || v == "true" || v == "yes"); };
                if      (k == "enabled")        setb(g_cfg.enabled);
                else if (k == "snap")           setb(g_cfg.snap);
                else if (k == "snap_dist")      seti(g_cfg.snapDist);
                else if (k == "drag_threshold") seti(g_cfg.dragThreshold);
                else if (k == "fps")            seti(g_cfg.fps);
                else if (k == "spring_k")       setd(g_cfg.springK);
                else if (k == "spring_damp")    setd(g_cfg.springDamp);
                else if (k == "wobble_factor")  setd(g_cfg.wobbleFactor);
                else if (k == "max_skew")       setd(g_cfg.maxSkewDeg);
                else if (k == "stretch_vel")    setd(g_cfg.stretchVel);
                else if (k == "squash_vel")     setd(g_cfg.squashVel);
                else if (k == "max_stretch")    setd(g_cfg.maxStretch);
                else if (k == "debug")          setb(g_cfg.debug);
            }
        }
    }
    CloseHandle(f);
    g_cfg.fps = std::max(30, std::min(144, g_cfg.fps));
}

static bool IsCandidateWindow(HWND hwnd)
{
    if (!hwnd || !IsWindow(hwnd) || !IsWindowVisible(hwnd)) return false;
    if (IsIconic(hwnd)) return false;
    LONG_PTR ex = GetWindowLongPtrW(hwnd, GWL_EXSTYLE);
    if (ex & WS_EX_TOOLWINDOW) return false;
    wchar_t cls[64];
    if (GetClassNameW(hwnd, cls, 64)) {
        if (!_wcsicmp(cls, L"Progman") || !_wcsicmp(cls, L"WorkerW") ||
            !_wcsicmp(cls, L"Shell_TrayWnd") || !_wcsicmp(cls, L"Shell_SecondaryTrayWnd") ||
            !_wcsicmp(cls, GHOST_CLASS) || !_wcsicmp(cls, MAIN_CLASS) ||
            !_wcsicmp(cls, L"Windows.UI.Core.CoreWindow"))
            return false;
    }
    return true;
}

static bool CaptureWindow(HWND hwnd, int w, int h, DragCtx& d)
{
    HDC wdc = GetWindowDC(hwnd);
    if (!wdc) return false;
    HDC mem = CreateCompatibleDC(wdc);
    BITMAPINFO bi{}; bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bi.bmiHeader.biWidth = w; bi.bmiHeader.biHeight = -h;
    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32;
    bi.bmiHeader.biCompression = BI_RGB;
    void* bits = nullptr;
    HBITMAP dib = CreateDIBSection(wdc, &bi, DIB_RGB_COLORS, &bits, nullptr, 0);
    if (!dib) { ReleaseDC(hwnd, wdc); DeleteDC(mem); return false; }
    HGDIOBJ old = SelectObject(mem, dib);
    BOOL ok = PrintWindow(hwnd, mem, PW_RENDERFULLCONTENT);
    if (!ok) ok = BitBlt(mem, 0, 0, w, h, wdc, 0, 0, SRCCOPY);
    if (ok && bits) {
        const unsigned char* p = (const unsigned char*)bits;
        long long sum = 0; int n = 0;
        for (int i = 0; i < 8; ++i) for (int j = 0; j < 8; ++j) {
            int px = (int)((double)w * (i + 0.5) / 8.0);
            int py = (int)((double)h * (j + 0.5) / 8.0);
            if (px >= w) px = w - 1; if (py >= h) py = h - 1;
            const unsigned char* q = p + ((size_t)py * w + px) * 4;
            sum += q[0] + q[1] + q[2]; ++n;
        }
        if (n && sum < 64) ok = FALSE;
    }
    SelectObject(mem, old);
    ReleaseDC(hwnd, wdc); DeleteDC(mem);
    if (!ok) { DeleteObject(dib); return false; }
    bool anyAlpha = false;
    for (int i = 0; i < 16 && !anyAlpha; ++i) {
        int px = (int)((double)w * ((i % 4) + 0.5) / 4.0);
        int py = (int)((double)h * ((i / 4) + 0.5) / 4.0);
        if (((unsigned char*)bits)[((size_t)py * w + px) * 4 + 3] != 0) anyAlpha = true;
    }
    if (!anyAlpha) {
        for (int y = 0; y < h; ++y)
            memset((unsigned char*)bits + (size_t)y * w * 4 + 3, 255, (size_t)w);
    }
    d.snapOpaque = !anyAlpha;
    d.snapW = w; d.snapH = h; d.snapBits = bits;
    d.snapDib = dib;
    d.snapDC = CreateCompatibleDC(nullptr);
    d.oldSnap = SelectObject(d.snapDC, d.snapDib);
    return true;
}

static LRESULT CALLBACK GhostProc(HWND h, UINT m, WPARAM w, LPARAM l)
{
    switch (m) {
    case WM_ERASEBKGND: return 1;
    case WM_PAINT: { PAINTSTRUCT ps; BeginPaint(h, &ps); EndPaint(h, &ps); return 0; }
    }
    return DefWindowProcW(h, m, w, l);
}

static bool EnsureOutBuffer(DragCtx& d, int bw, int bh)
{
    if (d.outDib && bw <= d.allocW && bh <= d.allocH) {
        d.bw = bw; d.bh = bh;
        return true;
    }
    if (d.outDC) {
        if (d.oldOut) SelectObject(d.outDC, d.oldOut);
        DeleteDC(d.outDC); d.outDC = nullptr; d.oldOut = nullptr;
    }
    if (d.outDib) { DeleteObject(d.outDib); d.outDib = nullptr; d.outBits = nullptr; }
    int aw = std::max(bw + 64, d.w + 160);
    int ah = std::max(bh + 64, d.h + 160);
    HDC sdc = GetDC(nullptr);
    BITMAPINFO bi{}; bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bi.bmiHeader.biWidth = aw; bi.bmiHeader.biHeight = -ah;
    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32;
    bi.bmiHeader.biCompression = BI_RGB;
    d.outDib = CreateDIBSection(sdc, &bi, DIB_RGB_COLORS, &d.outBits, nullptr, 0);
    ReleaseDC(nullptr, sdc);
    if (!d.outDib) return false;
    d.outDC = CreateCompatibleDC(nullptr);
    d.oldOut = SelectObject(d.outDC, d.outDib);
    SetStretchBltMode(d.outDC, COLORONCOLOR);
    d.allocW = aw; d.allocH = ah;
    d.bw = bw; d.bh = bh;
    return true;
}

static bool CreateGhost(int x, int y, int w, int h, DragCtx& d)
{
    HINSTANCE inst = (HINSTANCE)GetModuleHandleW(nullptr);
    WNDCLASSEXW wc{}; wc.cbSize = sizeof(wc); wc.lpfnWndProc = GhostProc;
    wc.hInstance = inst; wc.lpszClassName = GHOST_CLASS;
    wc.hCursor = LoadCursorW(nullptr, (LPCWSTR)IDC_ARROW);
    if (!GetClassInfoExW(inst, GHOST_CLASS, &wc)) RegisterClassExW(&wc);
    d.ghost = CreateWindowExW(
        WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE,
        GHOST_CLASS, L"", WS_POPUP,
        x, y, w, h, nullptr, nullptr, inst, nullptr);
    if (!d.ghost) return false;
    ShowWindow(d.ghost, SW_SHOWNOACTIVATE);
    return EnsureOutBuffer(d, w + 32, h + 32);
}

static void CleanupGhost(DragCtx& d)
{
    if (d.ghost) {
        DWORD_PTR res = 0;
        LRESULT s = SendMessageTimeoutW(d.ghost, WM_CLOSE, 0, 0,
                                        SMTO_ABORTIFHUNG, 800, &res);
        if (!s || IsWindow(d.ghost)) DestroyWindow(d.ghost);
        d.ghost = nullptr;
    }
    if (d.outDC) { if (d.oldOut) SelectObject(d.outDC, d.oldOut); DeleteDC(d.outDC); d.outDC = nullptr; }
    if (d.outDib) { DeleteObject(d.outDib); d.outDib = nullptr; }
    d.outBits = nullptr; d.allocW = d.allocH = 0;
    if (d.snapDC) { if (d.oldSnap) SelectObject(d.snapDC, d.oldSnap); DeleteDC(d.snapDC); d.snapDC = nullptr; }
    if (d.snapDib) { DeleteObject(d.snapDib); d.snapDib = nullptr; }
    d.snapBits = nullptr; d.snapW = d.snapH = 0;
    d.haveLast = false;
}

static double ClampD(double v, double lo, double hi)
{
    return v < lo ? lo : (v > hi ? hi : v);
}

// 与 script.js WobblyWindow.update() 同一组公式（每帧一步，无 dt）
static void StepPhysics(DragCtx& d)
{
    if (d.introActive) {
        // 从最大化拉下的"先变小"过渡：从最大化尺寸线性收缩到还原尺寸
        double t = duration_cast<duration<double>>(steady_clock::now() - d.introStart).count() / 0.18;
        if (t >= 1.0) {
            d.introScaleX = d.introScaleY = 1.0;
            d.introActive = false;
        } else {
            d.introScaleX = 1.0 + (d.intro0X - 1.0) * (1.0 - t);
            d.introScaleY = 1.0 + (d.intro0Y - 1.0) * (1.0 - t);
        }
    }
    if (g_phase == PH_DRAG) {
        d.tx = (double)g_mouseX - d.grabDX;
        d.ty = (double)g_mouseY - d.grabDY;
    } else {
        d.tx = d.relX;
        d.ty = d.relY;
    }
    const double k = g_cfg.springK;
    const double damp = g_cfg.springDamp;
    double ax = -k * (d.x - d.tx) - damp * d.vx;
    double ay = -k * (d.y - d.ty) - damp * d.vy;
    d.vx += ax;
    d.vy += ay;
    d.x += d.vx;
    d.y += d.vy;

    double skewX = -d.vx * g_cfg.wobbleFactor * 5.0;
    double skewY = -d.vy * g_cfg.wobbleFactor * 5.0;
    d.skewX = ClampD(skewX, -g_cfg.maxSkewDeg, g_cfg.maxSkewDeg);
    d.skewY = ClampD(skewY, -g_cfg.maxSkewDeg, g_cfg.maxSkewDeg);

    double sx = 1.0 + std::abs(d.vx) * g_cfg.stretchVel - std::abs(d.vy) * g_cfg.squashVel;
    double sy = 1.0 + std::abs(d.vy) * g_cfg.stretchVel - std::abs(d.vx) * g_cfg.squashVel;
    d.stretchX = ClampD(sx, 1.0 - g_cfg.maxStretch, 1.0 + g_cfg.maxStretch);
    d.stretchY = ClampD(sy, 1.0 - g_cfg.maxStretch, 1.0 + g_cfg.maxStretch);

    if (d.introActive) {
        // 收缩期间不叠加倾斜/拉伸：先变小，收缩完再出摇晃效果
        d.skewX = d.skewY = 0;
        d.stretchX = d.stretchY = 1;
    }
}

// CSS: translate3d(x,y) skew(sx,sy) scale(fx,fy)，transform-origin: center
static void MapLocal(const DragCtx& d, double px, double py, double& ox, double& oy)
{
    const double cx = d.w * 0.5, cy = d.h * 0.5;
    // introScale 仅在"从最大化拉下"的收缩过渡期 > 1，其余时候恒为 1
    double lx = (px - cx) * d.stretchX * d.introScaleX;
    double ly = (py - cy) * d.stretchY * d.introScaleY;
    const double kPi = 3.14159265358979323846;
    double tx = std::tan(d.skewX * kPi / 180.0);
    double ty = std::tan(d.skewY * kPi / 180.0);
    double rx = lx + ly * tx;
    double ry = ly + lx * ty;
    ox = d.x + cx + rx;
    oy = d.y + cy + ry;
}

// 定点仿射光栅器：与 MapLocal 同一组公式求逆（16.16 定点步进），单遍完成
// 采样 + alpha 修正 + 界外清零。替代原先的 memset+PlgBlt+alpha 扫描流水线：
// 实测本机 GDI PlgBlt 对 1300x700 窗口需 ~30ms/帧（60fps 一帧预算 16.6ms，
// 是掉帧主凶），本光栅器 ~4.6ms/帧，且恒等变换下与逐像素直接取样 0 差异。
// 视觉语义与 PlgBlt(COLORONCOLOR) 一致（最近邻采样）。
static void RasterizeWobble(DragCtx& d, int minx, int miny, int pw, int ph)
{
    const double A = d.stretchX * d.introScaleX;
    const double B = d.stretchY * d.introScaleY;
    const double kPi = 3.14159265358979323846;
    const double tx = std::tan(d.skewX * kPi / 180.0);
    const double ty = std::tan(d.skewY * kPi / 180.0);
    double K = 1.0 - tx * ty;
    if (std::abs(K) < 1e-9) K = (K < 0 ? -1e-9 : 1e-9);
    const double cx = d.w * 0.5, cy = d.h * 0.5;
    const int fdu = (int)std::llround(65536.0 / (A * K));   // 恒 > 0
    const int fdv = (int)std::llround(-65536.0 * ty / (B * K));
    const int fcx = (int)std::llround(cx * 65536.0);
    const int fcy = (int)std::llround(cy * 65536.0);
    const double dx0 = (double)minx - d.x - cx;
    uint32_t* out = (uint32_t*)d.outBits;
    const uint32_t* src = (const uint32_t*)d.snapBits;
    const int sw = d.snapW;
    const int w = d.w, h = d.h;
    // 窗口内像素一律不透明（黑色内容也是）：边界已由 px/py 范围检查
    // 明确判定，不再用旧 PlgBlt 管线"rgb==0 即透明"的 hack——那个
    // hack 会把纯黑文字/背景误判成窗口外而变透明。
    // snapOpaque（快照 alpha 已强制 255）时直接补 alpha；否则保留源
    // alpha（PrintWindow 通常返回 255，真实透明窗口则保持其透明度）。
    const bool opaque = d.snapOpaque;
    const long long wLimit = ((long long)w << 16) - 0x8000LL;

    for (int Y = 0; Y < ph; ++Y) {
        const double dy = (double)(miny + Y) - d.y - cy;
        int fu = (int)std::llround(((dx0 - tx * dy) / (A * K)) * 65536.0) + fcx;
        int fv = (int)std::llround(((dy - ty * dx0) / (B * K)) * 65536.0) + fcy;
        uint32_t* o = out + (size_t)Y * d.allocW;

        // 行级快速路径：整行 py 不变（垂直倾斜为零或极小，水平拖动的
        // 常态）时，py 只判定一次，px 用解析跨度切成三段，中段拷贝
        // 无逐像素边界分支——慢机器上这是主要的每帧 CPU 开销
        const int pyA = (fv + 0x8000) >> 16;
        const int pyB = (int)((((long long)fv + (long long)(pw - 1) * fdv) + 0x8000) >> 16);
        if (pyA == pyB) {
            if ((unsigned)pyA >= (unsigned)h) {
                memset(o, 0, (size_t)pw * 4);          // 整行在窗口外
                continue;
            }
            const uint32_t* srcRow = src + (size_t)(pyA + d.visOffY) * sw + d.visOffX;
            // 解析 px∈[0,w) 对应的 X 跨度 [Xs, Xe)
            int Xs = 0, Xe = pw;
            long long lo = -0x8000LL - fu;             // px>=0 ⟺ X*fdu >= lo
            if (lo > 0) {
                Xs = (int)((lo + fdu - 1) / fdu);      // ceil
                if (Xs > pw) Xs = pw;
            }
            long long hi = wLimit - fu;                // px<w ⟺ X*fdu < hi
            if (hi <= 0) {
                Xe = 0;
            } else {
                Xe = (int)((hi + fdu - 1) / fdu);      // ceil = 首个越界 X
                if (Xe > pw) Xe = pw;
            }
            if (Xs > Xe) Xs = Xe;
            if (Xs > 0) memset(o, 0, (size_t)Xs * 4);
            int f = fu + Xs * fdu;
            if (opaque) {
                for (int X = Xs; X < Xe; ++X) {
                    o[X] = srcRow[(f + 0x8000) >> 16] | 0xFF000000u;
                    f += fdu;
                }
            } else {
                for (int X = Xs; X < Xe; ++X) {
                    o[X] = srcRow[(f + 0x8000) >> 16];
                    f += fdu;
                }
            }
            if (Xe < pw) memset(o + Xe, 0, (size_t)(pw - Xe) * 4);
            continue;
        }

        // 通用路径：py 逐像素变化（垂直倾斜较大，多为瞬态）
        for (int X = 0; X < pw; ++X) {
            const int px = (fu + 0x8000) >> 16;
            const int py = (fv + 0x8000) >> 16;
            if ((unsigned)px < (unsigned)w && (unsigned)py < (unsigned)h) {
                const uint32_t p = src[(size_t)(py + d.visOffY) * sw + (px + d.visOffX)];
                o[X] = opaque ? (p | 0xFF000000u) : p;
            } else {
                o[X] = 0;
            }
            fu += fdu; fv += fdv;
        }
    }
}

static void Render(DragCtx& d)
{
    double x0, y0, x1, y1, x2, y2, x3, y3;
    MapLocal(d, 0, 0, x0, y0);
    MapLocal(d, (double)d.w, 0, x1, y1);
    MapLocal(d, 0, (double)d.h, x2, y2);
    MapLocal(d, (double)d.w, (double)d.h, x3, y3);

    // 静止帧跳过：位置与形状都完全静止（按住不动且弹簧已收敛）时才
    // 跳过整帧。必须同时检查形状参数——只查位置会把慢速拖动时的
    // 微小摇晃（手部 8~12Hz 生理性速度起伏引起的倾角振荡）一并冻结，
    // 表现为"拖久了摇晃动画消失"。
    const double q[8] = { x0, y0, x1, y1, x2, y2, x3, y3 };
    if (d.haveLast) {
        bool same = true;
        for (int i = 0; i < 8; ++i)
            if (std::abs(q[i] - d.lastQuad[i]) > 0.25) { same = false; break; }
        if (same &&
            std::abs(d.skewX - d.lastSkewX) <= 0.05 &&
            std::abs(d.skewY - d.lastSkewY) <= 0.05 &&
            std::abs(d.stretchX - d.lastStretchX) <= 0.002 &&
            std::abs(d.stretchY - d.lastStretchY) <= 0.002 &&
            std::abs(d.introScaleX - d.lastIntroX) <= 0.002 &&
            std::abs(d.introScaleY - d.lastIntroY) <= 0.002)
            return;
    }
    for (int i = 0; i < 8; ++i) d.lastQuad[i] = q[i];
    d.lastSkewX = d.skewX; d.lastSkewY = d.skewY;
    d.lastStretchX = d.stretchX; d.lastStretchY = d.stretchY;
    d.lastIntroX = d.introScaleX; d.lastIntroY = d.introScaleY;
    d.haveLast = true;

    int minx = (int)std::floor(std::min(std::min(x0, x1), std::min(x2, x3))) - 2;
    int miny = (int)std::floor(std::min(std::min(y0, y1), std::min(y2, y3))) - 2;
    int maxx = (int)std::ceil (std::max(std::max(x0, x1), std::max(x2, x3))) + 2;
    int maxy = (int)std::ceil (std::max(std::max(y0, y1), std::max(y2, y3))) + 2;
    int bw = std::max(1, maxx - minx);
    int bh = std::max(1, maxy - miny);
    // 上传区域按 64 对齐：尺寸在拖动中只偶尔变化，减少 DWM 侧表面
    // 反复重分配造成的掉帧
    const int aw = (bw + 63) & ~63;
    const int ah = (bh + 63) & ~63;

    if (!EnsureOutBuffer(d, bw, bh) || !d.outBits) return;
    const int pw = std::min(aw, d.allocW);
    const int ph = std::min(ah, d.allocH);

    // 单遍光栅化：采样 + alpha 修正 + 界外清零（覆盖整个上传区域，
    // 无需 memset，也无需单独的 alpha 扫描）
    RasterizeWobble(d, minx, miny, pw, ph);

    POINT pos{ minx, miny }; SIZE sz{ pw, ph }; POINT src{ 0, 0 };
    BLENDFUNCTION bf{ AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
    UpdateLayeredWindow(d.ghost, nullptr, &pos, &sz, d.outDC, &src, 0, &bf, ULW_ALPHA);
}

static void DwmSuppressTransitions(HWND hwnd, BOOL enable);   // 定义在下方

static void FinishDrag(DragCtx& d, bool cancel)
{
    if (d.hwnd && IsWindow(d.hwnd)) {
        int fx, fy;
        if (cancel) { fx = d.origX; fy = d.origY; }
        else { fx = (int)std::lround(d.x); fy = (int)std::lround(d.y); }
        // 兜底：若窗口仍处于最大化状态（此前还原未生效），落地前先还原，
        // 避免出现"能拖动但保持最大化外形"的怪窗口。等还原生效后再
        // 落地——对仍处于最大化状态的窗口做 SWP_NOSIZE 移动会产生
        // 画面残缺（部分黑屏）的窗口。
        bool stillMax = false;
        {
            WINDOWPLACEMENT chk{ sizeof(chk) };
            GetWindowPlacement(d.hwnd, &chk);
            if (chk.showCmd == SW_SHOWMAXIMIZED) {
                DwmSuppressTransitions(d.hwnd, TRUE);
                ShowWindow(d.hwnd, SW_RESTORE);
                DwmSuppressTransitions(d.hwnd, FALSE);
                for (int i = 0; i < 8; ++i) {
                    WINDOWPLACEMENT c2{ sizeof(c2) };
                    GetWindowPlacement(d.hwnd, &c2);
                    if (c2.showCmd != SW_SHOWMAXIMIZED) break;
                    Sleep(25);
                }
                WINDOWPLACEMENT c3{ sizeof(c3) };
                GetWindowPlacement(d.hwnd, &c3);
                stillMax = (c3.showCmd == SW_SHOWMAXIMIZED);
            }
        }
        if (stillMax) {
            // 极端情况（目标应用挂起）：直接按还原尺寸摆放，避免半黑画面；
            // 窗口状态留给系统/应用自行纠正
            SetWindowPos(d.hwnd, d.insertAfter,
                         fx - d.visOffX, fy - d.visOffY,
                         d.w + d.visOffX * 2, d.h + d.visOffX + d.visOffY,
                         SWP_NOZORDER | SWP_NOACTIVATE);
        } else {
            // fx/fy 是可见区左上角，换算回完整窗口矩形坐标
            SetWindowPos(d.hwnd, d.insertAfter, fx - d.visOffX, fy - d.visOffY, 0, 0,
                         SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
        }
        ShowWindow(d.hwnd, SW_SHOW);
        SetForegroundWindow(d.hwnd);
    }
    CleanupGhost(d);
}

// 绝对坐标注入移动（虚拟桌面归一化）：不受"提高指针精确度"加速曲线
// 影响，落点精确。相对 dx/dy 注入会被加速曲线放大/缩小，净位移不可控，
// 光标钉不到边缘上——贴靠预览的判定区很窄，命不中就没有预览。
#ifndef MOUSEEVENTF_VIRTUALDESKTOP
#define MOUSEEVENTF_VIRTUALDESKTOP 0x4000
#endif
static void InjectMoveAbs(long x, long y)
{
    long vl = GetSystemMetrics(SM_XVIRTUALSCREEN);
    long vt = GetSystemMetrics(SM_YVIRTUALSCREEN);
    long vw = GetSystemMetrics(SM_CXVIRTUALSCREEN);
    long vh = GetSystemMetrics(SM_CYVIRTUALSCREEN);
    INPUT in{}; in.type = INPUT_MOUSE;
    in.mi.dx = vw > 1 ? (LONG)((x - vl) * 65535.0 / (vw - 1)) : 0;
    in.mi.dy = vh > 1 ? (LONG)((y - vt) * 65535.0 / (vh - 1)) : 0;
    in.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE |
                    MOUSEEVENTF_VIRTUALDESKTOP;
    SendInput(1, &in, sizeof(INPUT));
}

// 松手贴靠：交还系统原生完成（渲染线程安全点调用）。
// 拖动全程保持果冻动画；松手时光标压在边缘，此时按钮已松开，
// 注入合成拖拽序列，让系统以原生方式走完贴靠——预览布局、DWM
// 过渡动画、Snap Assist、分屏尺寸记忆全部原生。
static RECT GetVisibleRect(HWND hwnd, const RECT& wr);   // 定义在下方

// 放置真窗口并验证它没被残留的异步离屏移动拽回屏外。
// 拖动期间真窗口被 SWP_ASYNCWINDOWPOS 异步移到 -32000；快速甩动时
// （拖拽只持续一两帧）这个异步移动可能还排在目标线程队列里，会在
// 我们同步放置之后才执行，把窗口又拽回屏外——表现为"窗口消失"。
// 这里放置后复查并重新放置，压过残留的异步移动。
static void PlaceWindowVerified(HWND hwnd, HWND insertAfter, long x, long y)
{
    SetWindowPos(hwnd, insertAfter, x, y, 0, 0,
                 SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
    // 仅当最近发过异步离屏移动（可能还排在目标线程队列里）才监控——
    // 这正是快速甩动的场景。正常拖动的异步早已落地，直接返回，
    // 不给预览增加延迟。监控期内每次发现被拽回屏外就重新放置，
    // 压过残留异步（不能"见在屏内就提前返回"，异步可能在返回后才落地）。
    if (GetTickCount64() - g_lastAsyncHide > 250) return;
    for (int i = 0; i < 4; ++i) {
        Sleep(10);
        RECT chk; GetWindowRect(hwnd, &chk);
        if (chk.left <= -10000 && chk.top <= -10000)
            SetWindowPos(hwnd, insertAfter, x, y, 0, 0,
                         SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
    }
}

// 拖动中交还（渲染线程调用，用户仍按着鼠标）：
// 光标贴边停留后触发。注入"抬起→按下"一对真实输入事件，让系统以
// 原生方式在标题栏上启动拖拽模态循环（DefWindowProc 处理
// WM_NCLBUTTONDOWN → SC_MOVE 循环）——与之前失败的 PostMessage
// 方案不同，真实输入事件启动的模态循环会跟踪后续一切移动（合成的
// 和物理的）。预览浮现后放行物理输入：用户继续移动可切换预览位置，
// 物理松开时系统原生完成贴靠。
static void EdgeHandoverLive(DragCtx& d)
{
    if (!d.hwnd || !IsWindow(d.hwnd)) {
        CleanupGhost(d);
        g_phase = PH_IDLE; g_cancel = 0;
        return;
    }
    POINT c{ g_mouseX.load(), g_mouseY.load() };
    RECT wa{};
    HMONITOR mon = MonitorFromPoint(c, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi{ sizeof(mi) };
    bool atEdge = false;
    if (GetMonitorInfoW(mon, &mi)) {
        wa = mi.rcWork;
        atEdge = (c.y <= wa.top + 8 || c.x <= wa.left + 8 || c.x >= wa.right - 9);
    }
    Dbg("EdgeHandoverLive: cur=(%ld,%ld) atEdge=%d", c.x, c.y, (int)atEdge);
    if (!atEdge || !(GetAsyncKeyState(VK_LBUTTON) & 0x8000)) {
        return;   // 已离开边缘或已松开：本次不交还，继续果冻拖动
    }
    // 关键：钳制到工作区。低级钩子会报告越界坐标（快速甩动时的过冲，
    // 如 y=-22）——用它锚定窗口会让标题栏跑出屏幕外，且与注入光标的
    // 合法坐标脱节（按下点落到标题栏下方的客户区，原生拖拽循环根本
    // 不启动，预览因此从未出现过）
    c.x = std::max((long)wa.left, std::min(c.x, (long)wa.right - 1));
    c.y = std::max((long)wa.top,  std::min(c.y, (long)wa.bottom - 1));
    // 会话标志立即置位：若用户在本函数执行期间物理松开，钩子看到
    // wasNative 会跳过松手注入路径，避免 live+release 双重注入
    g_nativeDrag = true;
    g_handoverAt = GetTickCount64();
    // 平行移动点：沿边缘方向 12px（超过拖动阈值激活模态循环跟踪，
    // 光标全程贴边不离开判定区）。取代旧的"内移再回边缘"折返——
    // 折返会让按下点与抓取点错位
    POINT par = c;
    if (c.y <= wa.top + 8)        par.x = std::min((long)wa.right - 2, c.x + 12);
    else if (c.x <= wa.left + 8)  par.y = std::min((long)wa.bottom - 2, c.y + 12);
    else                          par.y = std::min((long)wa.bottom - 2, c.y + 12);
    // 记住本次拖动开始时的窗口矩形（拖出分屏时恢复原大小）
    g_snapHwnd = d.hwnd;
    g_snapPrevRect.left   = d.origX - d.visOffX;
    g_snapPrevRect.top    = d.origY - d.visOffY;
    g_snapPrevRect.right  = g_snapPrevRect.left + d.snapW;
    g_snapPrevRect.bottom = g_snapPrevRect.top + d.snapH;
    // 真窗口放回：抓取点对准（钳制后的）光标——与幽灵最后位置无缝，
    // 且随后的按下恰好落在标题栏的抓取点上。用验证放置压过残留的
    // 异步离屏移动（快速甩动时窗口否则会"消失"）
    PlaceWindowVerified(d.hwnd, d.insertAfter,
                        c.x - d.grabDX - d.visOffX, c.y - d.grabDY - d.visOffY);
    ShowWindow(d.hwnd, SW_SHOW);
    SetForegroundWindow(d.hwnd);
    CleanupGhost(d);
    g_phase = PH_IDLE; g_cancel = 0;
    // 吸收物理移动：注入期间手部漂移不得干扰（抬起/按下照常透传）
    g_absorbAt = GetTickCount64();
    g_absorb = 1;
    Sleep(15);   // 等真窗口就位（最短必要余量）
    // 1) 光标归位到抓取点（=窗口放回时的锚点，必在标题栏上）
    InjectMoveAbs(c.x, c.y);
    Sleep(10);
    if (!(GetAsyncKeyState(VK_LBUTTON) & 0x8000)) {
        // 注入前用户已松开：不能启动原生拖拽循环（没有配对的抬起，
        // 窗口会卡在拖拽态）。转松手注入路径，由它完成贴靠
        POINT rc; GetCursorPos(&rc);
        g_relPtX = rc.x; g_relPtY = rc.y;
        g_absorb = 0;
        g_nativeDrag = false;
        g_edgeHandover = 1;
        Dbg("EdgeHandoverLive: released mid-flight, fall back to release path");
        return;
    }
    // 2) 注入"抬起→按下"：按下落在标题栏抓取点上，DefWindowProc
    //    启动原生标题栏拖拽模态循环
    INPUT ud[2]{};
    ud[0].type = INPUT_MOUSE;
    ud[0].mi.dwFlags = MOUSEEVENTF_LEFTUP;
    ud[1].type = INPUT_MOUSE;
    ud[1].mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
    UINT rn = SendInput(2, ud, sizeof(INPUT));
    Sleep(15);
    // 3) 沿边缘平行移动 12px：模态循环进入跟踪，光标始终贴边——
    //    预览随系统贴边停留逻辑浮现
    InjectMoveAbs(par.x, par.y);
    Sleep(25);
    // 4) 验证原生模态循环是否真的接手：窗口应跟随移动了 ~12px。
    //    没接手（按下没落到标题栏/应用忙）就立即经主线程重接管恢复
    //    果冻——消灭"动画消失但预览也没出现"的死区（"有时不灵"）
    bool tracking = false;
    if (IsWindow(d.hwnd)) {
        RECT wr; GetWindowRect(d.hwnd, &wr);
        long placedL = c.x - d.grabDX - d.visOffX;
        long placedT = c.y - d.grabDY - d.visOffY;
        long moved = std::abs(wr.left - placedL) + std::abs(wr.top - placedT);
        tracking = moved >= 6;
        Dbg("EdgeHandoverLive: verify moved=%ld tracking=%d", moved, (int)tracking);
    }
    g_absorb = 0;
    if (!tracking) {
        // 交还失败：请求主线程重接管（幽灵窗口须归主线程消息泵）
        PostMessageW(g_mainWnd, WM_RETARGET, (WPARAM)d.hwnd,
                     MAKELPARAM((SHORT)par.x, (SHORT)par.y));
        Dbg("EdgeHandoverLive: handover failed, retarget posted");
        return;
    }
    Dbg("EdgeHandoverLive: absorb=off, native drag in control");
}

static void EdgeHandover(DragCtx& d)
{
    if (!d.hwnd || !IsWindow(d.hwnd)) {
        CleanupGhost(d);
        g_phase = PH_IDLE; g_cancel = 0;
        return;
    }
    HWND target = d.hwnd;   // 结果探测用（CleanupGhost 不清 d.hwnd，此处留档）
    // 以钩子记录的松手点为基准（而非事后的 GetCursorPos——人手松开后
    // 常有惯性漂移，窗口按松手点放回，光标也须归位到松手点上，
    // 否则注入的按下可能落在标题栏之外）
    POINT c{ g_relPtX.load(), g_relPtY.load() };
    RECT wa{};
    HMONITOR mon = MonitorFromPoint(c, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi{ sizeof(mi) };
    bool atEdge = false;
    if (GetMonitorInfoW(mon, &mi)) {
        wa = mi.rcWork;
        atEdge = (c.y <= wa.top + 8 || c.x <= wa.left + 8 || c.x >= wa.right - 9);
    }
    Dbg("EdgeHandover: relPt=(%ld,%ld) atEdge=%d", c.x, c.y, (int)atEdge);
    if (!atEdge) {
        // 竞态：松手点不在边缘，按普通落地
        FinishDrag(d, false);
        g_phase = PH_IDLE; g_cancel = 0;
        return;
    }
    // 钳制到工作区：钩子会报告越界坐标（快速甩动过冲，如 y=-22），
    // 用它锚定窗口会让标题栏跑出屏幕、按下点落到客户区（拖拽循环
    // 不启动、无贴靠）
    c.x = std::max((long)wa.left, std::min(c.x, (long)wa.right - 1));
    c.y = std::max((long)wa.top,  std::min(c.y, (long)wa.bottom - 1));
    // 平行移动点：沿边缘方向 12px（超拖动阈值激活模态循环跟踪，
    // 光标全程贴边）
    POINT par = c;
    if (c.y <= wa.top + 8)        par.x = std::min((long)wa.right - 2, c.x + 12);
    else if (c.x <= wa.left + 8)  par.y = std::min((long)wa.bottom - 2, c.y + 12);
    else                          par.y = std::min((long)wa.bottom - 2, c.y + 12);
    // 吸收物理鼠标输入直到序列结束：手部惯性漂移不得干扰合成序列
    g_absorbAt = GetTickCount64();
    g_absorb = 1;
    // 记住本次拖动开始时的窗口矩形：系统的分屏尺寸记忆只对自己的
    // 拖拽生效，从半屏被我们接管拖出时用它恢复原大小
    g_snapHwnd = d.hwnd;
    g_snapPrevRect.left   = d.origX - d.visOffX;
    g_snapPrevRect.top    = d.origY - d.visOffY;
    g_snapPrevRect.right  = g_snapPrevRect.left + d.snapW;
    g_snapPrevRect.bottom = g_snapPrevRect.top + d.snapH;
    // 真窗口放回：原抓取点对准（钳制后的）松手点——随后的按下
    // 恰好落在标题栏抓取点上。验证放置压过残留异步离屏移动（防"窗口消失"）
    PlaceWindowVerified(d.hwnd, d.insertAfter,
                        c.x - d.grabDX - d.visOffX, c.y - d.grabDY - d.visOffY);
    ShowWindow(d.hwnd, SW_SHOW);
    SetForegroundWindow(d.hwnd);
    CleanupGhost(d);
    g_phase = PH_IDLE; g_cancel = 0;
    Sleep(15);   // 等真窗口就位（最短必要余量）
    g_handoverAt = GetTickCount64();   // 抑制钩子把合成输入当新拖拽候选
    // 松手路径：用户已决定贴靠，无需"预览展示停顿"，序列压到最短——
    // 按下（抓取点）、沿边缘平行移动、立即抬起，贴靠瞬间完成
    // 0) 光标归位到松手点（钳制后，必为标题栏抓取点）
    InjectMoveAbs(c.x, c.y);
    Sleep(8);
    // 1) 按下（启动原生拖拽模态循环）
    INPUT dn[1]{};
    dn[0].type = INPUT_MOUSE;
    dn[0].mi.dwFlags = MOUSEEVENTF_LEFTDOWN;
    UINT r1 = SendInput(1, dn, sizeof(INPUT));
    Sleep(12);
    // 2) 沿边缘平行移动 12px：超过拖动阈值进入跟踪，光标始终贴边
    InjectMoveAbs(par.x, par.y);
    Sleep(12);
    // 3) 抬起：立即原生贴靠完成（最大化/半屏，带 DWM 动画）
    INPUT up[1]{};
    up[0].type = INPUT_MOUSE;
    up[0].mi.dwFlags = MOUSEEVENTF_LEFTUP;
    UINT r2 = SendInput(1, up, sizeof(INPUT));
    Sleep(15);   // 让系统开始处理贴靠再放行物理输入
    g_absorb = 0;
    Dbg("EdgeHandover: done r1=%u r2=%u press=(%ld,%ld) par=(%ld,%ld)",
        (unsigned)r1, (unsigned)r2, c.x, c.y, par.x, par.y);
    (void)target;
}

// DWM 过渡动画开关。注意 DWMWA_TRANSITIONS_ENABLED_OVERRIDE 的语义是
// 反的：属性值 TRUE = 禁用过渡动画，FALSE = 恢复启用。抑制还原瞬间
// 闪烁时传 suppress=TRUE，用完必须传 FALSE 恢复——否则之后最大化等
// 系统过渡动画会全部消失。
typedef HRESULT(WINAPI* DwmSetAttrFn)(HWND, DWORD, const void*, DWORD);
static void DwmSuppressTransitions(HWND hwnd, BOOL suppress)
{
    static DwmSetAttrFn setAttr = nullptr;
    static bool tried = false;
    if (!tried) {
        tried = true;
        HMODULE m = LoadLibraryW(L"dwmapi.dll");
        if (m) setAttr = (DwmSetAttrFn)GetProcAddress(m, "DwmSetWindowAttribute");
    }
    if (setAttr)
        setAttr(hwnd, 3 /* DWMWA_TRANSITIONS_ENABLED_OVERRIDE */, &suppress, sizeof(suppress));
}

typedef HRESULT(WINAPI* DwmGetAttrFn)(HWND, DWORD, void*, DWORD);
static DwmGetAttrFn DwmGetAttrProc()
{
    static DwmGetAttrFn getAttr = nullptr;
    static bool tried = false;
    if (!tried) {
        tried = true;
        HMODULE m = LoadLibraryW(L"dwmapi.dll");
        if (m) getAttr = (DwmGetAttrFn)GetProcAddress(m, "DwmGetWindowAttribute");
    }
    return getAttr;
}

// 取窗口可见边界（不含 Win10/11 左右下侧的透明调整边）；失败时退回整个窗口矩形。
// 注意：个别环境（某些虚拟机/远程会话）DWMWA_EXTENDED_FRAME_BOUNDS 会返回
// S_OK 但矩形全 0 —— 必须校验，否则可见区为空，拖动接管会彻底失效。
static RECT GetVisibleRect(HWND hwnd, const RECT& wr)
{
    RECT vis = wr;
    bool haveDwm = false;
    DwmGetAttrFn getAttr = DwmGetAttrProc();
    if (getAttr) {
        RECT v{};
        if (SUCCEEDED(getAttr(hwnd, 14 /* DWMWA_EXTENDED_FRAME_BOUNDS */, &v, sizeof(v)))) {
            long vw = v.right - v.left, vh = v.bottom - v.top;
            long rw = wr.right - wr.left, rh = wr.bottom - wr.top;
            if (vw > 8 && vh > 8 && vw <= rw && vh <= rh &&
                v.left >= wr.left && v.top >= wr.top &&
                v.right <= wr.right && v.bottom <= wr.bottom) {
                vis = v;
                haveDwm = true;
            }
        }
    }
    if (!haveDwm) {
        // DWM 未给出有效边界：对带标准边框（标题栏+可调边框）的窗口，
        // 按系统度量去掉左右下的透明调整边；顶部无透明边不动。
        // 无标准边框的窗口（无边框弹窗等）不内缩。
        LONG_PTR style = GetWindowLongPtrW(hwnd, GWL_STYLE);
        if ((style & WS_CAPTION) && (style & WS_THICKFRAME)) {
            int dx = GetSystemMetrics(SM_CXSIZEFRAME) + GetSystemMetrics(SM_CXPADDEDBORDER);
            int dy = GetSystemMetrics(SM_CYSIZEFRAME) + GetSystemMetrics(SM_CXPADDEDBORDER);
            RECT h = wr;
            h.left += dx; h.right -= dx; h.bottom -= dy;
            if (h.right - h.left > 8 && h.bottom - h.top > 8) vis = h;
        }
    }
    return vis;
}

// 返回 true = 接管成功（果冻拖拽已启动）；false = 放弃接管
// （窗口保持原状/原生拖拽继续，调用方据此决定是否维持原生会话）
static bool StartDrag(HWND hwnd, POINT pt)
{
    DragCtx& d = g_drag;
    d.hwnd = hwnd;
    RECT r;
    RECT maxVis{}; bool fromMax = false;
    WINDOWPLACEMENT wp{ sizeof(wp) };
    GetWindowPlacement(hwnd, &wp);
    if (wp.showCmd == SW_SHOWMAXIMIZED) {
        fromMax = true;
        RECT mwr; GetWindowRect(hwnd, &mwr);
        maxVis = GetVisibleRect(hwnd, mwr);   // 记住最大化时的可见尺寸（收缩起点）
        // 从最大化状态开始拖：先还原（抑制 DWM 动画防止闪一下）。
        // 用 ShowWindow 而不是 SC_RESTORE 消息：前者在窗口管理器层面
        // 立即生效，不依赖目标应用处理排队消息（应用忙时 SC_RESTORE
        // 可能迟迟不生效，导致接管后真窗口仍是最大化状态的错乱）。
        DwmSuppressTransitions(hwnd, TRUE);
        ShowWindow(hwnd, SW_RESTORE);
        DwmSuppressTransitions(hwnd, FALSE);
        // 短暂确认还原生效（安全网）：等不到就放弃接管、让系统原生
        // 拖拽继续
        bool restored = false;
        for (int i = 0; i < 4; ++i) {
            WINDOWPLACEMENT chk{ sizeof(chk) };
            GetWindowPlacement(hwnd, &chk);
            if (chk.showCmd != SW_SHOWMAXIMIZED) { restored = true; break; }
            Sleep(15);
        }
        if (!restored) {
            Dbg("StartDrag: restore not applied in time, abort takeover");
            return false;
        }
        // 等应用重绘：还原瞬间应用仍按最大化尺寸排版，立即 PrintWindow
        // 会抓到"上半截正常、下半截纯黑"的快照（拖动中半黑画面的来源）
        Sleep(60);
        GetWindowRect(hwnd, &r);
        if (r.left < -10000 || r.top < -10000) {
            // 还原出来的位置在屏幕外（normal position 已损坏）：放回光标附近再拖
            SetWindowPos(hwnd, nullptr, pt.x - (r.right - r.left) / 2, pt.y - 20, 0, 0,
                         SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
            GetWindowRect(hwnd, &r);
        }
    } else {
        GetWindowRect(hwnd, &r);
    }
    // 本工具贴靠过分屏、且该窗口仍处于分屏几何：拖出时恢复贴靠前的
    // 尺寸（原生 Aero Snap 的行为）。系统的分屏尺寸记忆只对自己的
    // 拖拽生效，被我们接管的拖拽拿不到，故用自行记录的矩形恢复。
    // 几何判定必须用可见区：原生贴靠把可见区精确摆成半宽×工作区高，
    // 而窗口矩形左右下各多出约 8px 透明调整边——用窗口矩形比较
    // 会因边框误差永远命不中（表现为拖出时不恢复、手动调边框才恢复）。
    if (hwnd == g_snapHwnd && g_snapPrevRect.right > g_snapPrevRect.left) {
        RECT cr; GetWindowRect(hwnd, &cr);
        RECT cv = GetVisibleRect(hwnd, cr);
        HMONITOR smon = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
        MONITORINFO smi{ sizeof(smi) };
        if (GetMonitorInfoW(smon, &smi)) {
            int half = (smi.rcWork.right - smi.rcWork.left) / 2;
            int wh = smi.rcWork.bottom - smi.rcWork.top;
            int vw = cv.right - cv.left, vh = cv.bottom - cv.top;
            bool snapped = (std::abs(vw - half) <= 20 && std::abs(vh - wh) <= 20) ||
                           (std::abs(vw - half / 2) <= 20 && std::abs(vh - wh / 2) <= 20);
            snapped = snapped &&
                      (std::abs(cv.left - smi.rcWork.left) <= 20 ||
                       std::abs(cv.left - (smi.rcWork.left + half)) <= 20 ||
                       std::abs(cv.left - (smi.rcWork.left + half / 2)) <= 20);
            int pw = g_snapPrevRect.right - g_snapPrevRect.left;
            int ph = g_snapPrevRect.bottom - g_snapPrevRect.top;
            if (snapped && pw > 50 && ph > 50) {
                SetWindowPos(hwnd, nullptr, pt.x - pw / 2, pt.y - 20, pw, ph,
                             SWP_NOZORDER | SWP_NOACTIVATE);
                g_snapHwnd = nullptr;
                Sleep(50);   // 给应用一拍按新尺寸重排，避免抓到旧布局
                GetWindowRect(hwnd, &r);
            }
        }
    }
    // 可见区：去掉 DWM 透明调整边，幽灵窗口与真实可见窗口同尺寸
    RECT vis = GetVisibleRect(hwnd, r);
    d.w = vis.right - vis.left; d.h = vis.bottom - vis.top;
    if (d.w <= 8 || d.h <= 8) {
        // 保险：可见区异常时回退完整窗口矩形，绝不让拖动接管静默失效
        vis = r;
        d.w = r.right - r.left; d.h = r.bottom - r.top;
        if (d.w <= 8 || d.h <= 8) return false;
    }
    d.visOffX = vis.left - r.left;
    d.visOffY = vis.top - r.top;
    d.origX = vis.left; d.origY = vis.top;         // 可见区左上角
    d.grabDX = pt.x - vis.left; d.grabDY = pt.y - vis.top;
    d.insertAfter = GetWindow(hwnd, GW_HWNDPREV);
    if (!d.insertAfter) d.insertAfter = HWND_TOP;
    // 快照仍按整个窗口矩形抓（PrintWindow 需要完整尺寸），渲染时只取可见子区。
    // 从最大化还原后/系统拖拽过渡中，应用可能还没画完，抓到大面积纯黑
    // 就等一拍重试。strict 场景（还原后、原生会话重接管）重试后仍全黑
    // 则放弃接管——宁可不摇晃，也不能演一个黑窗口，更不能反复重试
    // 阻塞钩子。普通拖动的深色窗口（黑底终端等）不受 strict 影响。
    const bool strictBlack = fromMax || g_nativeDrag.load();
    bool captured = false, contentOk = false;
    for (int attempt = 0; attempt < 3; ++attempt) {
        if (attempt > 0) {
            if (d.snapDC) { if (d.oldSnap) SelectObject(d.snapDC, d.oldSnap); DeleteDC(d.snapDC); d.snapDC = nullptr; }
            if (d.snapDib) { DeleteObject(d.snapDib); d.snapDib = nullptr; }
            Sleep(60);
        }
        if (!CaptureWindow(hwnd, r.right - r.left, r.bottom - r.top, d)) break;
        captured = true;
        int dead = 0, total = 0;
        for (int i = 0; i < 6; ++i) for (int j = 0; j < 6; ++j) {
            int px = (int)((double)d.w * (i + 0.5) / 6.0) + d.visOffX;
            int py = (int)((double)d.h * (j + 0.5) / 6.0) + d.visOffY;
            COLORREF c = GetPixel(d.snapDC, px, py);
            ++total;
            if (c != CLR_INVALID &&
                GetRValue(c) + GetGValue(c) + GetBValue(c) < 10) ++dead;
        }
        if (dead * 2 < total) { contentOk = true; break; }   // 纯黑不足一半：有效
        Dbg("StartDrag: capture mostly black, retry %d (strict=%d)",
            attempt, (int)strictBlack);
    }
    if (!captured || (strictBlack && !contentOk)) {
        Dbg("StartDrag: capture failed/unusable, abort takeover");
        if (d.snapDC) { if (d.oldSnap) SelectObject(d.snapDC, d.oldSnap); DeleteDC(d.snapDC); d.snapDC = nullptr; }
        if (d.snapDib) { DeleteObject(d.snapDib); d.snapDib = nullptr; }
        d.snapBits = nullptr;
        return false;
    }
    if (!CreateGhost(vis.left, vis.top, d.w, d.h, d)) {
        SetWindowPos(hwnd, nullptr, d.origX - d.visOffX, d.origY - d.visOffY, 0, 0,
                     SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
        ShowWindow(hwnd, SW_SHOW);
        CleanupGhost(d);
        return false;
    }
    d.x = d.origX; d.y = d.origY;
    d.vx = d.vy = 0;
    d.tx = d.x; d.ty = d.y;
    d.stretchX = d.stretchY = 1;
    d.skewX = d.skewY = 0;
    // 从最大化拉下：先从最大化尺寸收缩到还原尺寸（约 0.18s），
    // 收缩完成后再进入正常摇晃
    d.introActive = false;
    d.introScaleX = d.introScaleY = 1;
    if (fromMax) {
        double sx0 = (double)(maxVis.right - maxVis.left) / d.w;
        double sy0 = (double)(maxVis.bottom - maxVis.top) / d.h;
        if (sx0 > 1.01 || sy0 > 1.01) {
            d.intro0X = sx0; d.intro0Y = sy0;
            d.introScaleX = sx0; d.introScaleY = sy0;
            d.introActive = true;
            d.introStart = steady_clock::now();
        }
    }
    // 先把幽灵窗口画在真窗口正上方（内容一致），确认显示成功后再隐藏
    // 真窗口，消除"窗口消失一帧"的闪烁
    Render(d);
    ReleaseCapture();
    SendMessageTimeoutW(hwnd, WM_CANCELMODE, 0, 0, SMTO_ABORTIFHUNG, 80, nullptr);
    SetWindowPos(hwnd, nullptr, -32000, -32000, 0, 0,
                 SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_ASYNCWINDOWPOS);
    g_lastAsyncHide = GetTickCount64();
    g_phase = PH_DRAG; g_cancel = 0;
    if (g_wakeEvent) SetEvent(g_wakeEvent);   // 立即唤醒渲染线程出第一帧
    return true;
}

struct Candidate { bool valid = false; HWND hwnd = nullptr; int downX = 0, downY = 0; };
static Candidate g_cand;
static HHOOK g_hook = nullptr;

static LRESULT CALLBACK LowLevelMouseProc(int nCode, WPARAM wParam, LPARAM lParam)
{
    if (nCode == HC_ACTION) {
        MSLLHOOKSTRUCT* ms = (MSLLHOOKSTRUCT*)lParam;
        // 贴靠注入序列期间：只吞物理移动（防手部惯性漂移干扰合成
        // 序列），左键按下/抬起一律透传——用户的松手意图必须立即
        // 生效，否则贴靠会"顿一下"才发生。2 秒保底防锁死。
        if (g_absorb && !(ms->flags & LLMHF_INJECTED) &&
            wParam == WM_MOUSEMOVE &&
            GetTickCount64() - g_absorbAt < 2000)
            return 1;
        switch (wParam) {
        case WM_LBUTTONDOWN:
            g_lbuttonDown = true;
            if (g_phase == PH_RELEASE && g_drag.ghost && IsWindow(g_drag.ghost)) {
                POINT pt = ms->pt;
                if (WindowFromPoint(pt) == g_drag.ghost) {
                    g_drag.grabDX = pt.x - (int)std::lround(g_drag.x);
                    g_drag.grabDY = pt.y - (int)std::lround(g_drag.y);
                    g_cancel = 0;
                    g_phase = PH_DRAG;
                }
            }
            if (g_cfg.enabled && g_phase == PH_IDLE && !g_nativeDrag &&
                GetTickCount64() - g_handoverAt > 500) {
                // 会话抑制 + 500ms 窗口：交还系统原生拖拽后不再接管，
                // 直到用户物理松开鼠标
                HWND under = WindowFromPoint(ms->pt);
                HWND root = GetAncestor(under, GA_ROOT);
                if (IsCandidateWindow(root)) {
                    DWORD_PTR hit = 0;
                    // 超时收紧到 60ms：低级鼠标钩子里同步等待太久会拖慢
                    // 全局鼠标输入（掉帧感的来源之一），应用太忙时宁可
                    // 这次点击不做动画
                    BOOL sent = SendMessageTimeoutW(root, WM_NCHITTEST, 0,
                                                    MAKELPARAM((SHORT)ms->pt.x, (SHORT)ms->pt.y),
                                                    SMTO_ABORTIFHUNG, 60, &hit);
                    // Win11 资源管理器等应用：根窗口在整个标题栏都返回 HTCLIENT，
                    // HTCAPTION 由标题栏子窗口（如 TITLE_BAR_SCAFFOLDING）返回，
                    // 因此根窗口未命中时再问实际命中的子窗口
                    if (sent && (LRESULT)hit != HTCAPTION && under != root) {
                        sent = SendMessageTimeoutW(under, WM_NCHITTEST, 0,
                                                   MAKELPARAM((SHORT)ms->pt.x, (SHORT)ms->pt.y),
                                                   SMTO_ABORTIFHUNG, 60, &hit);
                    }
                    if (sent && (LRESULT)hit == HTCAPTION) {
                        g_cand.valid = true; g_cand.hwnd = root;
                        g_cand.downX = ms->pt.x; g_cand.downY = ms->pt.y;
                    }
                }
            }
            break;
        case WM_MOUSEMOVE:
            g_mouseX = ms->pt.x; g_mouseY = ms->pt.y;
            // 原生拖拽会话（预览已取消）：光标明确离开边缘 = 用户放弃
            // 贴靠继续拖动——重新接管，恢复果冻摇晃。
            // 迟滞条件：离开所有贴靠边 >64px 且持续 >100ms。此前"出
            // 8px 带即重接管"会在贴边拖动时因手部微起伏反复横跳，
            // 交还与重接管乒乓（StartDrag 抓快照阻塞钩子、注入序列
            // 吞移动——鼠标被反复卡住，原生拖拽循环刚启动就被打断，
            // 预览永远稳不住）。150ms 冷却盖过注入序列本身。
            if (g_nativeDrag && g_lbuttonDown && g_cfg.enabled &&
                !(ms->flags & LLMHF_INJECTED) &&
                GetTickCount64() - g_handoverAt > 150 &&
                g_phase == PH_IDLE) {
                HMONITOR mon = MonitorFromPoint(ms->pt, MONITOR_DEFAULTTONEAREST);
                MONITORINFO mi{ sizeof(mi) };
                bool farFromEdge = true;
                if (GetMonitorInfoW(mon, &mi)) {
                    const RECT& wa = mi.rcWork;
                    long dl = ms->pt.x - wa.left;
                    long dr = (wa.right - 1) - ms->pt.x;
                    long dt = ms->pt.y - wa.top;
                    long dEdge = std::min(std::min(dl, dr), dt);
                    farFromEdge = dEdge > 48;
                }
                if (!farFromEdge) {
                    g_awaySince = 0;
                } else {
                    if (g_awaySince == 0) {
                        g_awaySince = GetTickCount64();
                    } else if (GetTickCount64() - g_awaySince > 60) {
                        g_awaySince = 0;
                        HWND under = WindowFromPoint(ms->pt);
                        HWND root = GetAncestor(under, GA_ROOT);
                        DWORD_PTR hit = 0;
                        BOOL sent = SendMessageTimeoutW(root, WM_NCHITTEST, 0,
                                                        MAKELPARAM((SHORT)ms->pt.x, (SHORT)ms->pt.y),
                                                        SMTO_ABORTIFHUNG, 60, &hit);
                        if (sent && (LRESULT)hit != HTCAPTION && under != root)
                            sent = SendMessageTimeoutW(under, WM_NCHITTEST, 0,
                                                       MAKELPARAM((SHORT)ms->pt.x, (SHORT)ms->pt.y),
                                                       SMTO_ABORTIFHUNG, 60, &hit);
                        if (sent && (LRESULT)hit == HTCAPTION && IsCandidateWindow(root)) {
                            Dbg("hook: native drag left edge, re-takeover at (%ld,%ld)",
                                ms->pt.x, ms->pt.y);
                            // 接管成功才结束原生会话；失败（如快照全黑）
                            // 保持原生拖拽，避免黑幽灵窗口和反复重试卡钩子
                            if (StartDrag(root, ms->pt))
                                g_nativeDrag = false;
                        }
                    }
                }
            } else if (!g_nativeDrag) {
                g_awaySince = 0;
            }
            if (g_phase == PH_RELEASE &&
                duration_cast<milliseconds>(steady_clock::now() - g_drag.releaseAt).count() >
                    (int)(g_cfg.maxDragSec * 1000) + 500) {
                // 不在钩子线程里直接收尾（与渲染线程存在资源竞态），
                // 交给渲染线程处理
                g_forceFinish = 1;
            }
            if (g_cand.valid && g_phase == PH_IDLE && g_lbuttonDown) {
                int dx = ms->pt.x - g_cand.downX, dy = ms->pt.y - g_cand.downY;
                if (std::abs(dx) > g_cfg.dragThreshold || std::abs(dy) > g_cfg.dragThreshold) {
                    HWND h = g_cand.hwnd; g_cand.valid = false;
                    StartDrag(h, ms->pt);
                }
            }
            break;
        case WM_LBUTTONUP:
            g_lbuttonDown = false;
            g_awaySince = 0;
            if (!(ms->flags & LLMHF_INJECTED)) {
                bool wasNative = g_nativeDrag.exchange(false);
                if (wasNative) {
                    // 原生拖拽会话进行中（交还已完成/进行中）：物理松开
                    // 由系统模态循环自行处理（完成贴靠或普通放置），
                    // 不得再走松手注入路径——否则双重注入
                    g_cand.valid = false;
                    break;
                }
            }
            if (g_phase == PH_DRAG) {
                g_mouseX = ms->pt.x; g_mouseY = ms->pt.y;
                g_drag.relX = g_mouseX - g_drag.grabDX;
                g_drag.relY = g_mouseY - g_drag.grabDY;
                // 光标贴在屏幕边缘（顶/左/右，8px 判定带）松手：立即交还
                // 系统做原生贴靠。判定带比"必须压到 1-2px"宽松——人手/
                // 虚拟机鼠标松手常差几像素；反正注入序列会把光标精确
                // 钉到边缘坐标，松手时的精确位置不再关键
                bool edge = false;
                HMONITOR mon = MonitorFromPoint(ms->pt, MONITOR_DEFAULTTONEAREST);
                MONITORINFO mi{ sizeof(mi) };
                if (GetMonitorInfoW(mon, &mi)) {
                    const RECT& wa = mi.rcWork;
                    edge = (ms->pt.y <= wa.top + 8 ||
                            ms->pt.x <= wa.left + 8 ||
                            ms->pt.x >= wa.right - 9);
                }
                if (edge) {
                    // 记录松手点：EdgeHandover 用它锚定窗口与光标，
                    // 避免人手惯性漂移导致注入的按下落到标题栏外
                    g_relPtX = ms->pt.x; g_relPtY = ms->pt.y;
                    Dbg("hook: release at edge (%ld,%ld), handover flag set",
                        ms->pt.x, ms->pt.y);
                    g_phase = PH_IDLE;
                    g_cancel = 0;
                    g_edgeHandover = 1;
                } else {
                    g_drag.releaseAt = steady_clock::now();
                    g_phase = PH_RELEASE;
                }
            }
            g_cand.valid = false;
            break;
        }
    }
    return CallNextHookEx(nullptr, nCode, wParam, lParam);
}

static LRESULT CALLBACK LowLevelKbdProc(int nCode, WPARAM wParam, LPARAM lParam)
{
    if (nCode == HC_ACTION) {
        KBDLLHOOKSTRUCT* kb = (KBDLLHOOKSTRUCT*)lParam;
        if ((wParam == WM_KEYDOWN || wParam == WM_SYSKEYDOWN) &&
            kb->vkCode == VK_ESCAPE && g_phase != PH_IDLE)
            g_cancel = 1;
    }
    return CallNextHookEx(nullptr, nCode, wParam, lParam);
}

#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
#endif

static void EdgeHandoverLive(DragCtx& d);   // 定义在上方

static void RenderThread()
{
    timeBeginPeriod(1);
    // 渲染线程略提高优先级，降低被其他进程抢占导致的掉帧
    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
    // 高精度可等待定时器（Win10 1803+）：帧间隔精确到亚毫秒级且不空转 CPU。
    // 之前"sleep 到还差 1.5ms 再自旋"的方案会在核心数少的环境里抢占
    // DWM/目标进程的 CPU 时间，本身就会造成掉帧感。
    HANDLE hrt = CreateWaitableTimerExW(nullptr, nullptr,
                                        CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
                                        TIMER_ALL_ACCESS);
    const auto frame = microseconds(1000000 / g_cfg.fps);
    const double frameSec = duration_cast<duration<double>>(frame).count();
    // JS 按 RAF~60Hz 积分；物理以固定 60Hz 步长累加推进，显示帧率无论
    // 高低，动画速度都与原始积分一致（不随帧率漂移）
    const double physDt = 1.0 / 60.0;
    double physAcc = 0.0;      // 物理积分时间累加器
    double emaCost = frameSec; // 平滑渲染耗时（秒），初始取帧预算
    auto next = steady_clock::now();
    auto physLast = steady_clock::now();
    auto lastWatch = steady_clock::now();
    auto edgeSince = steady_clock::time_point::max();   // 光标进入边缘带的时刻
    while (g_running) {
        steady_clock::time_point frameT0{};   // 本帧工作开始时刻（自适应节拍用）
        // 钩子线程发来的请求在本线程的安全点处理（幽灵窗口资源归本线程，
        // 跨线程销毁是崩溃来源）
        if (g_edgeHandover.exchange(0)) {
            EdgeHandover(g_drag);
            continue;
        }
        if (g_forceFinish.exchange(0)) {
            FinishDrag(g_drag, false);
            g_phase = PH_IDLE; g_cancel = 0;
            continue;
        }
        int phase = g_phase.load();
        if (phase == PH_DRAG || phase == PH_RELEASE) {
            frameT0 = steady_clock::now();
            double acc = duration_cast<duration<double>>(frameT0 - physLast).count();
            physLast = frameT0;
            // 固定步长物理积分：累加真实流逝时间按 1/60s 一步推进。帧率不足
            // 60 时一帧多步、帧率超 60 时偶发零步，动画速度始终与 60Hz
            // 原始积分一致（旧的 lround(acc*60) 在帧率变化时会让动画忽快
            // 忽慢，叠加上帧率腰斩就是"卡卡的"的直接来源）
            physAcc += acc;
            if (physAcc > 0.10) physAcc = 0.10;   // 卡顿恢复后最多补 ~6 步
            int steps = 0;
            while (physAcc >= physDt && steps < 8) {
                StepPhysics(g_drag);
                physAcc -= physDt;
                ++steps;
            }
            Render(g_drag);
            if (g_drag.hwnd && IsWindow(g_drag.hwnd)) {
                RECT wr; GetWindowRect(g_drag.hwnd, &wr);
                // 加 SWP_ASYNCWINDOWPOS：跨进程同步 SetWindowPos 会阻塞渲染线程
                // 等待目标进程响应，目标一忙帧率就掉（拖动不跟手的来源之一）
                if (wr.left > -10000 || wr.top > -10000) {
                    SetWindowPos(g_drag.hwnd, nullptr, -32000, -32000, 0, 0,
                                 SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE |
                                 SWP_ASYNCWINDOWPOS);
                    g_lastAsyncHide = GetTickCount64();
                }
            }
            if (phase == PH_DRAG && !g_lbuttonDown.load()) {
                if (duration_cast<milliseconds>(steady_clock::now() - lastWatch).count() > 1500) {
                    g_drag.relX = g_mouseX - g_drag.grabDX;
                    g_drag.relY = g_mouseY - g_drag.grabDY;
                    g_drag.releaseAt = steady_clock::now();
                    g_phase = PH_RELEASE;
                }
            } else {
                lastWatch = steady_clock::now();
            }
            // 拖动中光标贴边停留检测：进入边缘带开始计时，停留约 80ms
            // （≈5 帧，够快接近原生即时感，又能滤掉贴边快速扫过）→
            // 交还系统，原生贴靠预览浮现（不用松手）；松手才真正贴靠
            if (phase == PH_DRAG) {
                POINT mc{ g_mouseX.load(), g_mouseY.load() };
                HMONITOR mon = MonitorFromPoint(mc, MONITOR_DEFAULTTONEAREST);
                MONITORINFO mi{ sizeof(mi) };
                bool inBand = false;
                if (GetMonitorInfoW(mon, &mi)) {
                    const RECT& wa = mi.rcWork;
                    inBand = (mc.y <= wa.top + 8 || mc.x <= wa.left + 8 ||
                              mc.x >= wa.right - 9);
                }
                if (inBand) {
                    if (edgeSince == steady_clock::time_point::max())
                        edgeSince = steady_clock::now();
                    else if (duration_cast<milliseconds>(
                                 steady_clock::now() - edgeSince).count() > 80) {
                        edgeSince = steady_clock::time_point::max();
                        EdgeHandoverLive(g_drag);
                        continue;
                    }
                } else {
                    edgeSince = steady_clock::time_point::max();
                }
            } else {
                edgeSince = steady_clock::time_point::max();
            }
            if (g_cancel) {
                FinishDrag(g_drag, true);
                g_phase = PH_IDLE; g_cancel = 0;
            } else if (phase == PH_RELEASE) {
                double elapsed = duration_cast<duration<double>>(
                    steady_clock::now() - g_drag.releaseAt).count();
                double spd = std::sqrt(g_drag.vx * g_drag.vx + g_drag.vy * g_drag.vy);
                double lag = std::abs(g_drag.tx - g_drag.x) + std::abs(g_drag.ty - g_drag.y);
                if ((elapsed > 0.12 && spd < g_cfg.settleVel && lag < g_cfg.settleDist) ||
                    elapsed > g_cfg.maxDragSec) {
                    FinishDrag(g_drag, false);
                    g_phase = PH_IDLE; g_cancel = 0;
                }
            }
        } else {
            physLast = steady_clock::now();
            physAcc = 0;      // 空闲期间清掉物理累加，避免下次拖拽起步猛追
            // 空闲等待用事件唤醒：拖拽一启动立刻出帧，不再受固定 30ms
            // 轮询间隔拖累（此前拖动开始最多延迟 30ms 才有第一帧动画）
            if (g_wakeEvent)
                WaitForSingleObject(g_wakeEvent, 30);
            else
                std::this_thread::sleep_for(milliseconds(30));
            continue;
        }
        // 自适应帧节拍：period = max(用户帧预算, 平滑渲染耗时×1.2)。
        // 旧的 next += frame; if(next<=tn) next=tn+frame 在渲染耗时刚
        // 跨过预算时会丢一整帧再等一整帧，帧率在 60fps 与 ~30fps 之间
        // 整体跳变——核显+高分屏"移动卡顿"主要就来自这个腰斩。现在按
        // 实测耗时的平滑值定节拍：快机器稳 60fps，慢机器稳在它能跟上
        // 的帧率，不再来回跳。
        double cost = duration_cast<duration<double>>(steady_clock::now() - frameT0).count();
        emaCost = emaCost * 0.9 + cost * 0.1;
        if (emaCost > 0.05) emaCost = 0.05;   // 单帧尖峰（DWM 抖动等）不长期压低帧率
        const double periodSec = std::max(frameSec, emaCost * 1.2);
        next = frameT0 + duration_cast<steady_clock::duration>(duration<double>(periodSec));
        auto tn = steady_clock::now();
        if (next <= tn) next = tn + duration_cast<steady_clock::duration>(duration<double>(periodSec));
        // 帧等待：优先用高精度定时器（亚毫秒精度、无自旋）；不可用时
        // 退回普通 sleep
        if (hrt) {
            long long remainNs = duration_cast<nanoseconds>(
                next - steady_clock::now()).count();
            if (remainNs > 0) {
                LARGE_INTEGER due;
                due.QuadPart = -((remainNs + 99) / 100);   // 100ns 单位，负值=相对
                SetWaitableTimer(hrt, &due, 0, nullptr, nullptr, FALSE);
                WaitForSingleObject(hrt, INFINITE);
            }
        } else {
            std::this_thread::sleep_until(next);
        }
    }
    if (hrt) CloseHandle(hrt);
    timeEndPeriod(1);
}

static bool g_trayAdded = false;

static void TrayAdd(HWND h)
{
    NOTIFYICONDATAW nid{}; nid.cbSize = sizeof(nid);
    nid.hWnd = h; nid.uID = 1;
    nid.uFlags = NIF_ICON | NIF_MESSAGE | NIF_TIP;
    nid.uCallbackMessage = WM_TRAY;
    nid.hIcon = LoadIconW(nullptr, (LPCWSTR)IDI_APPLICATION);
    lstrcpynW(nid.szTip, L"WindowsFX Lite  果冻拖拽", 128);
    Shell_NotifyIconW(NIM_ADD, &nid);
    g_trayAdded = true;
}

static void TrayRemove(HWND h)
{
    NOTIFYICONDATAW nid{}; nid.cbSize = sizeof(nid);
    nid.hWnd = h; nid.uID = 1;
    Shell_NotifyIconW(NIM_DELETE, &nid);
    g_trayAdded = false;
}

static void ShowMenu(HWND h)
{
    HMENU m = CreatePopupMenu();
    AppendMenuW(m, MF_STRING | (g_cfg.enabled ? MF_CHECKED : 0), 1, L"启用果冻拖拽");
    AppendMenuW(m, MF_SEPARATOR, 0, nullptr);
    AppendMenuW(m, MF_STRING, 2, L"退出");
    POINT pt; GetCursorPos(&pt);
    SetForegroundWindow(h);
    int cmd = TrackPopupMenu(m, TPM_RETURNCMD | TPM_RIGHTBUTTON | TPM_NONOTIFY,
                             pt.x, pt.y, 0, h, nullptr);
    DestroyMenu(m);
    if (cmd == 1) g_cfg.enabled = !g_cfg.enabled;
    else if (cmd == 2) PostMessageW(h, WM_CLOSE, 0, 0);
}

static LRESULT CALLBACK MainProc(HWND h, UINT m, WPARAM w, LPARAM l)
{
    switch (m) {
    case WM_TRAY:
        if (LOWORD(l) == WM_RBUTTONUP || LOWORD(l) == WM_LBUTTONDBLCLK) ShowMenu(h);
        return 0;
    case WM_HOTKEY:
        g_cfg.enabled = !g_cfg.enabled;
        return 0;
    case WM_RETARGET: {
        // 交还验证失败后的重接管：幽灵窗口须归主线程（有消息泵）
        HWND th = (HWND)w;
        POINT pt{ (short)LOWORD(l), (short)HIWORD(l) };
        if (IsWindow(th)) StartDrag(th, pt);
        g_nativeDrag = false;   // 无论成败都结束原生会话，恢复正常逻辑
        return 0;
    }
    case WM_CLOSE:
        PostQuitMessage(0);
        return 0;
    }
    return DefWindowProcW(h, m, w, l);
}

int WINAPI WinMain(HINSTANCE inst, HINSTANCE, LPSTR, int)
{
    SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
    LoadConfig();
    WNDCLASSEXW wc{}; wc.cbSize = sizeof(wc); wc.lpfnWndProc = MainProc;
    wc.hInstance = inst; wc.lpszClassName = MAIN_CLASS;
    wc.hCursor = LoadCursorW(nullptr, (LPCWSTR)IDC_ARROW);
    RegisterClassExW(&wc);
    HANDLE mtx = CreateMutexW(nullptr, TRUE, L"Local\\WindowsFXLite_Singleton");
    if (!mtx || GetLastError() == ERROR_ALREADY_EXISTS) return 0;
    g_mainWnd = CreateWindowExW(0, MAIN_CLASS, L"WindowsFX Lite", WS_POPUP,
                                0, 0, 0, 0, nullptr, nullptr, inst, nullptr);
    TrayAdd(g_mainWnd);
    RegisterHotKey(g_mainWnd, 1, MOD_CONTROL | MOD_ALT, 'W');
    // 主线程承载低级鼠标钩子：略提优先级，系统忙时鼠标事件仍能及时
    // 送达本进程（降低拖动输入延迟与偶发卡顿）
    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
    g_wakeEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
    g_hook = SetWindowsHookExW(WH_MOUSE_LL, LowLevelMouseProc, inst, 0);
    HHOOK kb = SetWindowsHookExW(WH_KEYBOARD_LL, LowLevelKbdProc, inst, 0);
    std::thread rt(RenderThread);
    MSG msg;
    while (GetMessageW(&msg, nullptr, 0, 0) > 0) {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }
    g_running = false;
    rt.join();
    if (g_phase != PH_IDLE) {
        if (g_drag.hwnd && IsWindow(g_drag.hwnd)) {
            SetWindowPos(g_drag.hwnd, g_drag.insertAfter,
                         g_drag.origX - g_drag.visOffX, g_drag.origY - g_drag.visOffY,
                         0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
            ShowWindow(g_drag.hwnd, SW_SHOW);
        }
        CleanupGhost(g_drag);
        g_phase = PH_IDLE;
    }
    if (kb) UnhookWindowsHookEx(kb);
    if (g_hook) UnhookWindowsHookEx(g_hook);
    UnregisterHotKey(g_mainWnd, 1);
    if (g_trayAdded) TrayRemove(g_mainWnd);
    return 0;
}
